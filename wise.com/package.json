{
  "name": "wise-homepage-clone",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc -b && vite build",
    "preview": "vite preview",
    "test": "npm run test:contracts && npm run test:unit",
    "test:contracts": "node --test tests/contracts.test.mjs",
    "test:unit": "vitest run tests/App.test.ts --environment happy-dom",
    "typecheck": "vue-tsc -b"
  },
  "dependencies": {
    "lucide-vue-next": "latest",
    "vue": "latest"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "latest",
    "@vue/test-utils": "^2.4.6",
    "happy-dom": "^20.14.0",
    "typescript": "~5.9.3",
    "vite": "latest",
    "vitest": "^5.0.0",
    "vue-tsc": "latest"
  }
}
