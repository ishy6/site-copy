{"title":"MAKR","bodyClass":"account/login","bodyStyle":"background:#fff","html":"\n                \n\n\n    <div class=\"account-content account-login-create\">\n        <div class=\"login\">\n            <h1>Sign In</h1>\n            <p>Welcome back.   Sign in to your account area.</p>\n            <div class=\"signin-content\">\n                    \n<form method=\"post\" accept-charset=\"UTF-8\">\n    \n    <input type=\"hidden\" name=\"action\" value=\"users/login\">\n    <input type=\"hidden\" name=\"redirect\" value=\"fe73ecb85e28560c6b71ffcb723389e9f10834d8f4b16bb2f0bc95c25d52b373account\">\n\n    <div class=\"checkout-label-field-pair\">\n        <input type=\"text\" id=\"loginName\" name=\"loginName\" class=\"input\" value=\"\" required placeholder=\"Email Address\">\n    </div>\n\n    <div class=\"checkout-label-field-pair\">\n        <input type=\"password\" id=\"loginPassword\" name=\"password\" placeholder=\"Password\" class=\"input\">\n    </div>\n    \n    <div>\n        <div>\n            <button type=\"submit\" class=\"checkout-button\">Login</button>\n        </div>\n        <div>\n            <a href=\"/account/forgot-password\" class=\"forgot-password\">Forgot password</a>\n        </div>\n    </div>\n</form>            </div>\n        </div>\n        <div class=\"create\">\n            <h1>New Here?</h1>\n            <p>Checkout faster and view order history</p>\n            <div class=\"create-content\">\n                <a class=\"checkout-button\" href=\"/account/register\">Create an account</a>\n            </div>\n        </div>\n    </div>\n\n        ","products":[]}